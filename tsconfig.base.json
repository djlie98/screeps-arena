{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Resolved relative to this file's own directory (the repo root), not
    // wherever a given arena's tsconfig.json extends it from - so this one
    // "common/*" mapping works for every arena's src/main.ts.
    "baseUrl": ".",
    "paths": {
      "common/*": ["common/*"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true
  }
}
